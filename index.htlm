<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Miguel Valero Pacho | Portfolio DAM</title>
    <style>
        /* Estilos Globales */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: white;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow-x: hidden;
            /* Fondo con degradado animado */
            background: linear-gradient(-45deg, #0f2027, #2c3e50, #203a43, #2c5364);
            background-size: 400% 400%;
            animation: gradientMove 15s ease infinite;
        }

        @keyframes gradientMove {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Canvas para las estrellas */
        #starCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
        }

        /* Contenido del Portfolio */
        .container {
            position: relative;
            z-index: 2; /* Por encima de las estrellas */
            max-width: 700px;
            width: 90%;
            text-align: center;
        }

        section {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 25px;
            padding: 40px;
            margin-bottom: 30px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
            transition: 0.4s ease;
        }

        section:hover {
            transform: scale(1.02);
            border-color: rgba(0, 210, 255, 0.5);
        }

        h1 {
            font-size: 3rem;
            margin-bottom: 10px;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.3);
        }

        .tag {
            display: inline-block;
            background: #00d2ff;
            color: #000;
            padding: 5px 15px;
            border-radius: 50px;
            font-size: 0.9rem;
            font-weight: bold;
            margin-bottom: 20px;
        }

        p {
            font-size: 1.1rem;
            line-height: 1.7;
            color: #efefef;
        }

        h2 {
            margin-bottom: 20px;
            color: #00d2ff;
        }

        .btn-email {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 30px;
            color: #00d2ff;
            text-decoration: none;
            font-weight: bold;
            border: 2px solid #00d2ff;
            border-radius: 50px;
            transition: all 0.3s ease;
        }

        .btn-email:hover {
            background: #00d2ff;
            color: #1a1a1a;
            box-shadow: 0 0 15px rgba(0, 210, 255, 0.6);
        }

        footer {
            margin-top: 10px;
            font-size: 0.8rem;
            opacity: 0.6;
        }
    </style>
</head>
<body>

    <canvas id="starCanvas"></canvas>

    <div class="container">
        <section id="sobre-mi">
            <h1>Miguel Valero Pacho</h1>
            <span class="tag">Estudiante de 1º de DAM</span>
            <p>
                Impulsando mi carrera en el <strong>Desarrollo de Aplicaciones Multiplataforma</strong>. 
                Enfocado en aprender, crear y resolver problemas a través del código.
            </p>
        </section>

        <section id="contacto">
            <h2>Contáctanos</h2>
            <p>¿Interesado en trabajar juntos o tienes alguna pregunta?</p>
            <a href="mailto:miguel@tucorreo.com" class="btn-email">miguel@tucorreo.com</a>
        </section>

        <footer>
            &copy; 2024 Miguel Valero Pacho | Developer en proceso
        </footer>
    </div>

    <script>
        const canvas = document.getElementById('starCanvas');
        const ctx = canvas.getContext('2d');
        let stars = [];

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        window.addEventListener('resize', resize);
        resize();

        class Star {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2;
                this.speed = Math.random() * 0.5 + 0.1;
            }
            update() {
                this.y -= this.speed;
                if (this.y < 0) {
                    this.y = canvas.height;
                    this.x = Math.random() * canvas.width;
                }
            }
            draw() {
                ctx.fillStyle = 'white';
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        for (let i = 0; i < 150; i++) {
            stars.push(new Star());
        }

        function animate() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            stars.forEach(star => {
                star.update();
                star.draw();
            });
            requestAnimationFrame(animate);
        }
        animate();
    </script>
</body>
</html>
